# ── RAKSHA AI Backend — Production Environment (Render) ──────────
# Set these as Environment Variables in the Render dashboard.
# DO NOT commit real secrets to git.

# ── FastAPI / Runtime ───────────────────────────────
FASTAPI_DEBUG=false
FASTAPI_SECRET_KEY=generate-a-strong-random-secret-here
BACKEND_HOST=0.0.0.0
# Render assigns PORT automatically; do NOT set BACKEND_PORT here.

# ── CORS — your Vercel frontend URL ─────────────────
CORS_ORIGINS=https://your-frontend.vercel.app,https://your-custom-domain.com

# ── WhatsApp bridge — runs inside the same container ─
WHATSAPP_BRIDGE_URL=http://localhost:3001

# ── Supabase ──────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_SERVICE_KEY=your-service-role-key

# ── Groq AI ─────────────────────────────────────────
GROQ_API_KEY=gsk_your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TEXT_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# ── NumVerify ────────────────────────────────────────
NUMVERIFY_API_KEY=your-numverify-api-key

# ── Live Intel / Evidence ───────────────────────────
INTEGRATION_HMAC_SECRET=generate-a-random-hmac-secret
INTEGRATION_REQUIRE_SIGNATURE=false
EVIDENCE_LEDGER_PATH=data_runtime/evidence_ledger.sqlite3
EVIDENCE_PACKAGE_DB_PATH=data_runtime/evidence_packages.sqlite3
EVIDENCE_SIGNING_PRIVATE_KEY_PATH=data_runtime/evidence_signing_private.pem
EVIDENCE_SIGNING_PUBLIC_KEY_PATH=data_runtime/evidence_signing_public.pem

# ── Agency Feed ─────────────────────────────────────
AGENCY_FEED_HMAC_SECRET=generate-a-distinct-hmac-secret
AGENCY_FEED_REQUIRE_SIGNATURE=false
AGENCY_FEED_DB_PATH=data_runtime/agency_feeds.sqlite3

# ── NETRA ───────────────────────────────────────────
NETRA_MODEL_DIR=data/netra/models
NETRA_DATASET_DIR=data/netra/datasets
NETRA_MIN_VALIDATION_ACCURACY=0.90
NETRA_MAX_FALSE_POSITIVE_RATE=0.06
